# Flask
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=login_page_session
SESSION_LIFETIME_MINUTES=60
SESSION_COOKIE_SECURE=true

# Public app URL as seen by the browser. Must be HTTPS in production.
APP_BASE_URL=https://login.example.com

# Auth0 OpenID Connect
AUTH0_DOMAIN=dev-vq8bl6lh7ac0zurf.us.auth0.com
AUTH0_CLIENT_ID=replace-auth0-client-id
AUTH0_CLIENT_SECRET=replace-auth0-client-secret
AUTH0_AUDIENCE=
# Optional override. Leave blank to use https://AUTH0_DOMAIN/.well-known/openid-configuration
OIDC_DISCOVERY_URL=

# F5 BIG-IP APM
# The Flask app will only trust identity headers from these proxy CIDRs.
TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
F5_AUTH_HEADER=X-Authenticated-User
F5_EMAIL_HEADER=X-Authenticated-Email
F5_NAME_HEADER=X-Authenticated-Name
F5_GROUPS_HEADER=X-Authenticated-Groups
F5_ID_TOKEN_HEADER=X-ID-Token
F5_LOGOUT_URL=https://login.example.com/my.logout.php3

# Set to true if F5 performs OIDC and forwards a validated ID token.
# Set to false to let Flask perform Auth0 Authorization Code Flow directly.
PREFER_F5_AUTH=true
